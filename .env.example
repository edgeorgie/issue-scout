# Optional: token to raise the GitHub API limit when not using OAuth.
# Use a fine-grained token with no access to private repositories (public data only).
GITHUB_TOKEN=
# Optional: GitHub OAuth App (callback: <origin>/api/auth/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: PostHog project token (public by design) for cookieless usage analytics.
# Leave empty to turn analytics off entirely: the SDK is not bundled, nothing is sent and the /ingest proxy route is not registered.
# See docs/adr/0002-cookieless-product-analytics.md for what is and is not collected.
NEXT_PUBLIC_POSTHOG_KEY=
